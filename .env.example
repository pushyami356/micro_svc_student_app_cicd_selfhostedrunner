
# ==========================================
# Student Microservices Environment Template
# Total: 13 environment variables
# ==========================================

# 1. MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# 2. JWT Authentication Secret
JWT_SECRET=CHANGE_ME_JWT_SECRET

# 3. Demo Login Passwords
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEMO_STUDENT_PASSWORD=CHANGE_ME_STUDENT_PASSWORD

# 4. Microservices Database Passwords
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_PASSWORD
STUDENT_DB_PASSWORD=CHANGE_ME_STUDENT_PASSWORD
ATTENDANCE_DB_PASSWORD=CHANGE_ME_ATTENDANCE_PASSWORD
MARKS_DB_PASSWORD=CHANGE_ME_MARKS_PASSWORD

# 5. Fernet Encryption Key
PASSWORD_ENCRYPTION_KEY=CHANGE_ME_PASSWORD_ENCRYPTION_KEY

# ==========================================
# 6. Microservices Database Connection URLs
# ==========================================

AUTH_DATABASE_URL=mysql+pymysql://auth_user:CHANGE_ME_AUTH_PASSWORD@database:3306/auth_db

STUDENTS_DATABASE_URL=mysql+pymysql://student_user:CHANGE_ME_STUDENT_PASSWORD@database:3306/student_db

ATTENDANCE_DATABASE_URL=mysql+pymysql://attendance_user:CHANGE_ME_ATTENDANCE_PASSWORD@database:3306/attendance_db

MARKS_DATABASE_URL=mysql+pymysql://marks_user:CHANGE_ME_MARKS_PASSWORD@database:3306/marks_db
